PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/goregaonmeds?retryWrites=true&w=majority

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=

ADMIN_USERNAME=
# Generate with `npm run hash-password`. Keep the single quotes: bcrypt hashes contain `$`.
ADMIN_PASSWORD_HASH=''

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=goregaonmeds/prescriptions

# Optional at boot: if missing or down, orders still save and return telegramNotificationSent=false.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=5874870761

# The Next.js site's origin (used for CORS and the admin CSRF origin check).
FRONTEND_URL=http://localhost:3000

# Number of reverse proxies in front of Express (Next.js rewrite + your host's load balancer).
TRUST_PROXY=1
